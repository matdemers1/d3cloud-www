{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/worker.ts", "src/head.ts", "src/routes.ts", "src/content", "src/floorspec/spec.ts", "src/floorspec/ast.ts"]
}
